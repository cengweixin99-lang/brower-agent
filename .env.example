# Local development only. Run pnpm env:init to generate .env with a random DB password.
POSTGRES_USER=pba
POSTGRES_PASSWORD=replace-with-local-random-password
POSTGRES_DB=pba
DATABASE_URL=postgresql://pba:replace-with-local-random-password@127.0.0.1:55433/pba
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=pba-local
API_HOST=127.0.0.1
API_PORT=3100
BROWSER_HOST=127.0.0.1
BROWSER_PORT=3101
ARTIFACT_DIR=.data/artifacts
# Configure provider credentials later; environment checks make no model requests.
